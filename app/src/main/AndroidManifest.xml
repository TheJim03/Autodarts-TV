<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV: no touchscreen required, declare leanback -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.AutodartsTV"
        android:usesCleartextTraffic="true">
        <!-- Cleartext is on for ONE reason: WLED controllers on the local network
             speak plain http only, and the Tools for Autodarts WLED features go
             through TfaBridge to reach them. TfaBridge refuses http to anything
             that is not a LAN address, and MainActivity keeps the WebView itself
             on https. See TfaBridge.cleartextRefusal(). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- This is what puts the app on the Android TV launcher -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
